      "timestamp": "00:01:15",
      "transcription": "Me llamo Juan Camilo Jurado Cifuentes. 29 años.",
      "claim_supported": "Self-identification and stated age.",
      "transcription_status": "human_verified_from_user_curated_notes"
    },
    {
      "timestamp": "00:03:36",
      "transcription": "Vengo de una familia amorosa. Mejor dar que recibir.",
      "claim_supported": "Stated family value of giving.",
      "transcription_status": "human_verified_from_user_curated_notes"
    },
    {
      "timestamp": "00:06:30",
      "transcription": "Todos hemos necesitado una mano. Y siempre todos hemos necesitado una ayuda.",
      "claim_supported": "Shared-humanity framing.",
      "transcription_status": "human_verified_from_user_curated_notes"
    },
    {
      "timestamp": "00:07:57",
      "transcription": "Yo no quiero ser el protagonista. Las protagonistas son las personas y no yo.",
      "claim_supported": "Anonymity principle: people helped are protagonists.",
      "transcription_status": "human_verified_from_user_curated_notes"
    }
